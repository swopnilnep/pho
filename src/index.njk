{% extends "layouts/base.njk" %}

{% block content %}
  {% for section in photos %}
    <section id="{{ section.title | slugify }}">
      <div class="album-head">
        <h2>{{ section.title }}</h2>
        <p class="meta">
          <em>{{ section.date }}{% if section.location %} · {{ section.location }}{% endif %}</em>
          {% if section.camera %}<span class="cam">{{ section.camera }}</span>{% endif %}
        </p>
        {% if section.description %}
          <p class="desc">{{ section.description }}</p>
        {% endif %}
      </div>

      <div class="gallery-grid">
        {% for image in section.images %}
          {% galleryImage image, section.title %}
        {% endfor %}
      </div>
    </section>
  {% endfor %}
{% endblock %}
