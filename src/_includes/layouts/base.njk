<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>photos by swopnil — photography by Swopnil Shrestha</title>
  <meta name="description" content="Photography by Swopnil Shrestha — landscapes, travel, and the occasional aurora.">
  <link rel="canonical" href="https://pho.swopnil.com/">

  <!-- Social share preview -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="photos by swopnil">
  <meta property="og:title" content="photos by swopnil">
  <meta property="og:description" content="Photography by Swopnil Shrestha — landscapes, travel, and the occasional aurora.">
  <meta property="og:url" content="https://pho.swopnil.com/">
  <meta property="og:image" content="https://pho.swopnil.com/og-image.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="photos by swopnil">
  <meta name="twitter:description" content="Photography by Swopnil Shrestha — landscapes, travel, and the occasional aurora.">
  <meta name="twitter:image" content="https://pho.swopnil.com/og-image.jpg">

  <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico">
  <link rel="icon" type="image/png" href="/favicon/favicon.png">
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@4.1.3/dist/photoswipe.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@4.1.3/dist/default-skin/default-skin.css">
</head>
<body>
  <!-- Inline icon sprite (replaces the Font Awesome CDN — 3 icons, no external request) -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="ic-cal" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></symbol>
    <symbol id="ic-pin" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></symbol>
    <symbol id="ic-cam" viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></symbol>
  </svg>
  <div class="container">
    <header>
      <h2 class="site-title"><span class="noodle">🍜</span> <b>pho</b>tos by swopnil</h2>
    </header>
    <main>
      {% block content %}{% endblock %} 
    </main>
    <footer class="site-footer">
      <div class="footer-site">
        <a href="https://swopnil.com" style="color: inherit; text-decoration: none;">swopnil.com</a>
      </div>
    </footer>
  </div>

  <!-- PhotoSwipe Template -->
  <div class="pswp" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="pswp__bg"></div>
    <div class="pswp__scroll-wrap">
      <div class="pswp__container">
        <div class="pswp__item"></div>
        <div class="pswp__item"></div>
        <div class="pswp__item"></div>
      </div>
      <div class="pswp__ui pswp__ui--hidden">
        <div class="pswp__top-bar">
          <div class="pswp__counter"></div>
          <button class="pswp__button pswp__button--close" title="Close (Esc)"></button>
          <button class="pswp__button pswp__button--share" title="Share"></button>
          <button class="pswp__button pswp__button--fs" title="Toggle fullscreen"></button>
          <button class="pswp__button pswp__button--zoom" title="Zoom in/out"></button>
          <div class="pswp__preloader">
            <div class="pswp__preloader__icn">
              <div class="pswp__preloader__cut">
                <div class="pswp__preloader__donut"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="pswp__share-modal pswp__share-modal--hidden pswp__single-tap">
          <div class="pswp__share-tooltip"></div>
        </div>
        <button class="pswp__button pswp__button--arrow--left" title="Previous (arrow left)"></button>
        <button class="pswp__button pswp__button--arrow--right" title="Next (arrow right)"></button>
        <div class="pswp__caption">
          <div class="pswp__caption__center"></div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/photoswipe@4.1.3/dist/photoswipe.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/photoswipe@4.1.3/dist/photoswipe-ui-default.min.js"></script>
  <script src="/scripts/gallery.js"></script> 
</body>
</html>